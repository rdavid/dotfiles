# Checks whether the given command exists.
cmd_exists() {
	command -v "$1" >/dev/null 2>&1
}

# Opens Vim for vi.
alias vi=vim

# Colors the ls output with the solarized-light theme.
if cmd_exists vivid; then
	LS_COLORS="$(vivid generate solarized-light)"
	export LS_COLORS
fi

# Prefers eza over ls and groups directories first. Defines l on top of ls.
if cmd_exists eza; then
	# The l alias builds on ls, so ls must be defined first. The alias
	# applies to interactive shells only:
	#  shellcheck disable=SC2262
	alias ls='eza --group-directories-first'
	alias l='ls --classify --grid --long'
else
	# Detects whether ls takes the GNU or the BSD color flag. The alias does
	# not apply in the same parsing unit:
	#  shellcheck disable=SC2263
	if ls --color >/dev/null 2>&1; then
		colorflag=--color
	else
		colorflag=-G
	fi

	# The l alias builds on ls, so ls must be defined first. The flag expands
	# when defined:
	#  shellcheck disable=SC2139
	alias ls="ls $colorflag"
	alias l='ls -lFh'
	unset colorflag
fi

# Lists all files, including hidden ones.
alias la='l -a'

# Prints files with plain bat output instead of cat.
if cmd_exists bat; then
	alias cat='bat --style=plain'
fi

# Always enables colored grep output.
alias grep='grep --color=auto'

# Provides short names for common commands. The ipe alias prints the public
# IP address.
alias h=history
alias untar='tar -zxvf'
alias ipe='curl ipinfo.io/ip'
alias c=clear

# Reloads the tmux configuration. The path expands when defined:
#  shellcheck disable=SC2139
alias src-tmux="tmux source-file $HOME/.tmux.conf"

# Reloads the zsh configuration. The path expands when defined:
#  shellcheck disable=SC2139
alias src="source $HOME/.zshrc"

# Makes rsync resumable, compressed, and verbose, with overall progress.
alias rsync='\
rsync \
--append-verify \
--archive \
--compress \
--human-readable \
--info=progress2 \
--partial \
--recursive \
--timeout=300 \
--verbose\
'

# Runs cmatrix with async scrolling, bold blue characters, and a slower delay.
alias cmatrix='cmatrix -a -b -u 6 -C blue'

# Updates Homebrew, upgrades formulae and casks, then removes old downloads.
if cmd_exists brew; then
	alias bu='
brew update &&
brew upgrade --yes &&
brew upgrade --cask --greedy --yes &&
brew cleanup --prune=all
'
fi

# Uses bfs in place of find.
if cmd_exists bfs; then
	alias find=bfs
fi

# Points python at python3.
if cmd_exists python3; then
	# The path expands when defined:
	#  shellcheck disable=SC2139
	alias python="$(command -v python3)"
fi
