# Holds the per-user Git configuration.

# Identifies the author and selects the GPG key for signing.
[user]
  name = David Rabkin
  email = david@rabkin.co.il
  signingkey = 61DA1757

# Defines the aliases.
[alias]
  # Lists files that have changed since master.
  files = !git diff --name-only $(git merge-base HEAD \"master\")

  # Shows a diff stat instead of just names, which suits interactive use.
  stat = !git diff --stat $(git merge-base HEAD \"master\")

  # Opens all files changed since master in Vim tabs. Runs fugitive's :Gdiff
  # in each tab and tells vim-gitgutter to show changes since master. Depends
  # on the files alias above.
  reviewall = !vim -p $(git files) +\"tabdo Gdiff master\" +\"let g:gitgutter_diff_base = 'master'\"

  # Works like reviewall, but takes the file names as arguments instead of
  # opening all changed files. Example: git reviewone foo.js bar.js
  reviewone = !vim -p +\"tabdo Gdiff master\" +\"let g:gitgutter_diff_base = 'master'\"

  # Shows a compact, colored graph of the history.
  lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

# Signs every commit.
[commit]
  gpgsign = true

# Uses gpg for signing.
[gpg]
  program = gpg

# Pages the output through delta.
[core]
  pager = delta

# Colors diffs with the zenburn theme, green for additions and red for
# removals.
[delta]
  syntax-theme = zenburn
  plus-style = "syntax #003500"
  plus-emph-style = "syntax #003500"
  plus-non-emph-style = "syntax #3f3f3f"
  minus-style = "syntax #3f0001"
  minus-emph-style = "syntax #3f0001"
  minus-non-emph-style = "syntax #3f3f3f"
  navigate = true

# Lets delta color interactive diffs, such as git add --patch.
[interactive]
  diffFilter = delta --color-only

# Shows the common ancestor in conflict markers with the zdiff3 style.
[merge]
  conflictStyle = zdiff3
