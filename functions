# Interactive helper functions sourced by bashrc and zshrc.
#
# Local is undefined and shellbase is not followed:
#  shellcheck disable=SC1091,SC3043

# Loads the shellbase library, which provides cmd_exists and other helpers.
. base.sh || return

# Plays a sound, runs the given command while keeping the machine awake, and
# plays another sound to signal completion. Works on macOS only.
beep() {
	cmd_exists afplay caffeinate || return $?
	afplay /System/Library/Sounds/Tink.aiff
	caffeinate "$@" || :
	afplay /System/Library/Sounds/Glass.aiff
}

# Evaluates an arithmetic expression with bc. Adds a leading zero to results
# like .5 and -.5, then strips trailing zeros and a trailing dot from the
# fraction.
calc() {
	cmd_exists bc || return $?
	local res
	res="$(printf 'scale=10;%s\n' "$*" | bc -l | tr -d '\\\n')"
	case "$res" in
	*.*)
		printf %s "$res" |
			sed \
				-e 's/^\./0./' \
				-e 's/^-\./-0./' \
				-e 's/0*$//;s/\.$//'
		;;
	*)
		printf %s "$res"
		;;
	esac
	printf \\n
}

# Wraps the builtin cd. With arguments, it behaves like the builtin. Without
# arguments, it browses directories interactively with fzf until the selection
# is canceled. Piping ls into grep is intentional:
#  shellcheck disable=SC2010
cd() {
	local dir lsd
	[ $# -eq 0 ] || {
		builtin cd "$@" || return
		return
	}
	cmd_exists fzf || return $?
	while :; do
		lsd=$(echo '..' && ls -p | grep '/$' | sed 's;/$;;')
		dir="$(printf %s\\n "$lsd" | fzf --reverse --preview 'ls -p {}')"
		[ -n "$dir" ] || return 0
		builtin cd "$dir" >/dev/null 2>&1 || return
	done
}

# Starts a Docker container chosen with fzf and attaches to it. The optional
# argument pre-fills the fzf query.
da() {
	local cid
	cmd_exists docker fzf || return $?
	cid=$(
		docker ps -a --format '{{.ID}}\t{{.Names}}\t{{.Status}}' |
			fzf -1 -q "$1" |
			awk '{print $1}'
	)
	[ -n "$cid" ] || return 0
	docker start "$cid" && docker attach "$cid"
}

# Stops a running Docker container chosen with fzf. The optional argument
# pre-fills the fzf query.
ds() {
	local cid
	cmd_exists docker fzf || return $?
	cid=$(
		docker ps --format '{{.ID}}\t{{.Names}}\t{{.Status}}' |
			fzf -q "$1" |
			awk '{print $1}'
	)
	[ -n "$cid" ] || return 0
	docker stop "$cid"
}

# Browses Git commits interactively with fzf. Enter shows the selected commit
# in less. Arguments pass through to git log.
fgit() {
	cmd_exists fzf git grep head less xargs || return $?
	git log \
		--color=always \
		--format="%C(auto)%h%d %s %C(black)%C(bold)%cr" \
		--graph \
		"$@" |
		fzf \
			--ansi \
			--bind=ctrl-s:toggle-sort \
			--no-sort \
			--reverse \
			--tiebreak=index \
			--bind "ctrl-m:execute:
			(
				grep -o '[a-f0-9]\{7\}' |
				head -1 |
				xargs -I % sh -c 'git show --color=always % | less -R'
			) << FZF-EOF
			{}
FZF-EOF"
}

# Kills processes selected with fzf, using the given signal or KILL by default.
# Root sees all processes, while other users see only their own.
fkill() {
	local pid
	cmd_exists fzf || return $?
	if [ "$(id -u)" = 0 ]; then
		pid=$(ps -ef | sed 1d | fzf -m | awk '{print $2}')
	else
		pid=$(ps -f -u "$(id -u)" | sed 1d | fzf -m | awk '{print $2}')
	fi
	[ -n "$pid" ] || return 0
	echo "$pid" | xargs kill -"${1:-9}"
}
